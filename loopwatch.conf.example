# loopwatch configuration — sourced by bin/loopwatch-run.sh (bash)
# cp loopwatch.conf.example loopwatch.conf && edit. $ROOT_DIR = the loopwatch/ dir.

# ── Sources ──────────────────────────────────────────────────────────────
# Claude Code session transcripts (append-only JSONL, watermarked by byte offset)
CLAUDE_CODE_GLOBS=("$HOME/.claude/projects/*/*.jsonl")

# Cowork session transcripts.
# NOTE: verify this glob on your machine with `bin/loopwatch-run.sh --list-sources`
# — the session storage layout under local-agent-mode-sessions may differ.
COWORK_GLOBS=("$HOME/Library/Application Support/Claude/local-agent-mode-sessions/*/*/*.jsonl")

# Git repos to mine for commit activity (watermarked by HEAD sha)
GIT_REPOS=(
  "$HOME/src/turbo-flow"
  # "$HOME/src/creando-tu-matrix"
)
GIT_INCLUDE_PATCH=false      # true = include capped diffs, not just log --stat

# ── Extraction ───────────────────────────────────────────────────────────
CLAUDE_BIN="claude"          # set absolute path (`which claude`) for launchd runs
MODEL="sonnet"               # nightly batch: sonnet is the right cost point
MAX_TURNS=50                 # runaway guard for the headless session
MAX_FILE_KB=200              # per-source delta cap fed to the model (post-filter)
ACTIVITY_MIN_BYTES=300       # below this total delta, the run is skipped

# ── Publish ──────────────────────────────────────────────────────────────
# SITE_DIR: where generated content lives. Default $ROOT_DIR/site.
# Point it at your existing Vercel-deployed content dir if you prefer, e.g.:
# SITE_DIR="$HOME/src/html-repo/public/catalog"
#SITE_DIR="$ROOT_DIR/site"

#REPO_DIR=""                 # auto-detected from SITE_DIR (git toplevel)
PULL=true                    # git pull --rebase --autostash before publishing
PUSH=true                    # push after commit (Vercel deploys from the push)
SKIP_EMPTY=true              # skip run entirely when no new activity
