{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pages"
  ],
  "properties": {
    "pages": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "slug",
          "title",
          "category",
          "tags",
          "summary",
          "source",
          "body_html"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^c[0-9]{1,2}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
          },
          "title": {
            "type": "string",
            "maxLength": 140,
            "minLength": 8
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)?$",
            "maxLength": 60
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.+-]{0,39}$",
              "maxLength": 40
            },
            "maxItems": 8
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600
          },
          "source": {
            "type": "string",
            "pattern": "^(claude-code|cowork|git):[^\\s]{1,100}$",
            "maxLength": 110
          },
          "body_html": {
            "type": "string",
            "description": "inner HTML of <main> after the title/meta: h2, p, ul/ol/li, pre/code, strong/em, table only",
            "minLength": 50,
            "maxLength": 30000
          }
        }
      }
    }
  }
}
