{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest_summary",
    "highlights",
    "candidates"
  ],
  "properties": {
    "digest_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "maxItems": 6
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "why",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]{1,2}$"
          },
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 140
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)?$",
            "maxLength": 60
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidence": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "start_line",
                "end_line"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              }
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
