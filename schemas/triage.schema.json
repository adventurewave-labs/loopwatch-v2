{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest_summary",
    "highlights",
    "candidates"
  ],
  "properties": {
    "digest_summary": {
      "type": "string"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "why",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]{1,2}$"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "start_line",
                "end_line"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "start_line": {
                  "type": "integer"
                },
                "end_line": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
