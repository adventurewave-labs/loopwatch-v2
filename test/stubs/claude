#!/usr/bin/env bash
# Stub claude CLI for the smoke test. Emulates the headless contract loopwatch relies on:
#   --help            -> flag list (STUB_HELP_FLAGS overrides which flags are "supported")
#   -p <prompt> ...   -> writes stage outputs into cwd, prints a --output-format json result
# Env knobs:
#   STUB_CALLS        file that gets one line per model invocation
#   STUB_PAGES        one (default) | none | unsafe | client | two   — what the extract stage writes
#   STUB_TRIAGE       one (default) | none                          — what the triage stage returns
#   STUB_FAIL         budget | crash                                 — simulate a failed call
#   STUB_MARKER       text planted in the persisted session transcript (self-ingestion test)
set -u

if [[ "${1:-}" == "--help" ]]; then
  for f in ${STUB_HELP_FLAGS:---output-format --max-budget-usd --no-session-persistence --strict-mcp-config --max-turns}; do
    echo "  $f    (stub)"
  done
  exit 0
fi

prompt="" model="" persist=true budget="" tools=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p) shift; prompt="$1" ;;
    --model) shift; model="$1" ;;
    --no-session-persistence) persist=false ;;
    --max-budget-usd) shift; budget="$1" ;;
    --allowedTools) shift; tools="$1" ;;
    --max-turns|--output-format) shift ;;
  esac
  shift
done

stage=extract
if printf '%s' "$prompt" | grep -q 'LOOPWATCH-STAGE: triage'; then stage=triage; fi
echo "call stage=$stage model=$model persist=$persist budget=$budget tools=$tools cwd=$PWD" >> "${STUB_CALLS:-/dev/null}"

# Emulate Claude Code session persistence: without --no-session-persistence the CLI
# writes the whole session (prompt context included) under ~/.claude/projects/<encoded cwd>/.
if [[ "$persist" == "true" ]]; then
  enc="$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"
  mkdir -p "$HOME/.claude/projects/$enc"
  jq -nc --arg cwd "$PWD" --arg t "persisted headless session: ${STUB_MARKER:-SELF-INGEST-MARKER} $(printf 'x%.0s' $(seq 1 400))" \
    '{type:"user", cwd:$cwd, message:{role:"user", content:$t}}' >> "$HOME/.claude/projects/$enc/stub-session.jsonl"
fi

result() {  # result <cost> <is_error> <subtype> [result-text]
  jq -nc --argjson cost "$1" --argjson err "$2" --arg sub "$3" --arg res "${4:-done}" --arg model "$model" '
    {type:"result", subtype:$sub, is_error:$err, duration_ms:1234, num_turns:3, result:$res,
     total_cost_usd:$cost,
     usage:{input_tokens:1200, cache_creation_input_tokens:300, cache_read_input_tokens:5000, output_tokens:800},
     modelUsage:{($model):{costUSD:$cost}}}'
}

case "${STUB_FAIL:-}" in
  budget) result 1.25 true error_max_budget_usd; exit 1 ;;
  crash)  echo "stub crash" >&2; exit 2 ;;
esac

page() {  # page <slug> <title> <extra-body-html>
  mkdir -p pages
  cat > "pages/$1.html" <<HTML
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>$2</title>
<style>body{background:#0f1115;color:#d7dae0}</style></head>
<body><main><h1>$2</h1>
<div class="meta">test</div><p>Decision: CronJob + queue; worker must be idempotent.</p>
$3
<footer>generated by loopwatch</footer></main></body></html>
HTML
}

meta_entry() {  # meta_entry <slug> <title>
  jq -nc --arg s "$1" --arg t "$2" '{file: ("pages/" + $s + ".html"), slug: $s, title: $t,
    category: "infra/kubernetes", tags: ["k8s"], summary: "CronJob + work queue; idempotent workers.",
    source: "claude-code:turbo-flow", candidate_id: "c1"}'
}

if [[ "$stage" == "triage" ]]; then
  if [[ "${STUB_TRIAGE:-one}" == "none" ]]; then
    result 0.02 false success '{"digest_summary":"Quiet day: routine edits only.","highlights":["routine edits"],"candidates":[]}'
  else
    first="$(ls bundle/transcripts 2>/dev/null | head -1)"
    result 0.03 false success "Here is the triage:
\`\`\`json
{\"digest_summary\":\"Settled the Turbo-Flow ingest architecture: K8s CronJob feeding a work queue.\",
 \"highlights\":[\"ingest architecture decided\"],
 \"candidates\":[{\"id\":\"c1\",\"title\":\"Turbo-Flow ingest: CronJob + work queue\",\"category\":\"infra/kubernetes\",
   \"why\":\"architecture decision with tradeoffs\",
   \"evidence\":[{\"file\":\"bundle/transcripts/${first:-missing.txt}\",\"start_line\":1,\"end_line\":40}]}]}
\`\`\`"
  fi
  exit 0
fi

# extract stage
entries=""
case "${STUB_PAGES:-one}" in
  none) ;;
  one)
    page k8s-cronjob-queue-ingest "Turbo-Flow ingest: CronJob + work queue" ""
    entries="$(meta_entry k8s-cronjob-queue-ingest "Turbo-Flow ingest: CronJob + work queue")" ;;
  two)
    page k8s-cronjob-queue-ingest "Turbo-Flow ingest: CronJob + work queue" ""
    page spot-pool-pdb-batch "Spot pool + PDB for batch ingest" ""
    entries="$(meta_entry k8s-cronjob-queue-ingest "Turbo-Flow ingest: CronJob + work queue"),$(meta_entry spot-pool-pdb-batch "Spot pool + PDB for batch ingest")" ;;
  unsafe)
    page safe-page-one "Safe page" ""
    page inline-script-page "Script page" "<script>alert(1)</script>"
    page onload-handler-page "Handler page" "<img src=x onerror=\"alert(1)\">"
    page external-img-page "External img" "<img src='//evil.example/p.png'>"
    page iframe-page "Iframe page" "<iframe src=\"about:blank\"></iframe>"
    page leaked-stripe-page "Stripe page" "<p>key sk_live_ABCDEFGHIJKLMNOPQRSTUVWX</p>"
    entries="$(meta_entry safe-page-one "Safe page"),$(meta_entry inline-script-page "Script page"),$(meta_entry onload-handler-page "Handler page"),$(meta_entry external-img-page "External img"),$(meta_entry iframe-page "Iframe page"),$(meta_entry leaked-stripe-page "Stripe page")" ;;
  client)
    page clean-page "Clean page" ""
    page client-page "Rollout notes" "<p>Deployed for Globex Corporation last night.</p>"
    entries="$(meta_entry clean-page "Clean page"),$(meta_entry client-page "Rollout notes")" ;;
esac
cat > run-meta.json <<JSON
{
  "run_date": "TEST",
  "digest_summary": "Settled the Turbo-Flow ingest architecture: K8s CronJob feeding a work queue, idempotent worker.",
  "highlights": ["ingest architecture decided", "one commit in srcrepo"],
  "pages": [${entries}]
}
JSON
result 0.12 false success
