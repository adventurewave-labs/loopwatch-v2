#!/usr/bin/env bash
# Stub claude CLI for the smoke test. Emulates the structured-mode headless contract:
#   --help                     -> flag list (STUB_HELP_FLAGS overrides which flags are "supported")
#   -p --system-prompt S --json-schema J --tools "" ... < input
#                              -> prints a --output-format json result with .structured_output
# Stage is detected from the system prompt marker (LOOPWATCH-STAGE: triage | extract).
# Env knobs:
#   STUB_CALLS        file that gets one line per model invocation
#   STUB_INPUTS       dir: each call's stdin is saved there as <stage>-<n>.txt
#   STUB_PAGES        one (default) | none | unsafe | unsafe2 | client | category | two | paraphrase | malformed | grounding — what the writer returns
#   STUB_TRIAGE       one (default) | none | garbage | traversal | dupid    — what triage returns
#   STUB_TRIAGE_COST  cost the triage stage reports (default 0.03)
#   STUB_FAIL         budget | budget0 | crash                       — simulate a failed call (budget0: error result, exit 0)
#   STUB_MARKER       text planted in the persisted session transcript (self-ingestion test)
#   STUB_DIGEST / STUB_HIGHLIGHT   override the digest summary / add a highlight
set -u

if [[ "${1:-}" == "--help" ]]; then
  for f in ${STUB_HELP_FLAGS:---output-format --max-budget-usd --no-session-persistence --strict-mcp-config --json-schema --tools --system-prompt --fallback-model}; do
    echo "  $f    (stub)"
  done
  exit 0
fi

sys="" schema="" model="" persist=true budget="" tools="<unset>" fbm=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p) ;;
    --model) shift; model="$1" ;;
    --system-prompt) shift; sys="$1" ;;
    --json-schema) shift; schema="$1" ;;
    --tools) shift; tools="$1" ;;
    --no-session-persistence) persist=false ;;
    --max-budget-usd) shift; budget="$1" ;;
    --fallback-model) shift; fbm="$1" ;;
    --output-format) shift ;;
  esac
  shift
done
input="$(cat)"

stage=extract
if printf '%s' "$sys" | grep -q 'LOOPWATCH-STAGE: triage'; then stage=triage; fi
has_bundle=no; printf '%s' "$input" | grep -q '<file path="bundle/' && has_bundle=yes
has_excerpt=no; printf '%s' "$input" | grep -q '<excerpt id=' && has_excerpt=yes
schema_ok=no; printf '%s' "$schema" | jq -e 'type == "object"' >/dev/null 2>&1 && schema_ok=yes
if [[ -n "${STUB_SCHEMAS:-}" ]]; then mkdir -p "$STUB_SCHEMAS"; printf '%s' "$schema" > "$STUB_SCHEMAS/$( printf '%s' "$sys" | grep -q 'LOOPWATCH-STAGE: triage' && echo triage || echo extract).json"; fi
echo "call stage=$stage model=$model fallback=[$fbm] persist=$persist budget=$budget tools=[$tools] schema=$schema_ok thinking=${MAX_THINKING_TOKENS:-unset} bundle=$has_bundle excerpts=$has_excerpt cwd=$PWD cwdfiles=$(ls -A | tr '\n' ',')" >> "${STUB_CALLS:-/dev/null}"
if [[ -n "${STUB_INPUTS:-}" ]]; then
  mkdir -p "$STUB_INPUTS"
  n=$(( $(ls "$STUB_INPUTS" | wc -l) + 1 ))
  printf '%s' "$input" > "$STUB_INPUTS/$stage-$n.txt"
fi

# Emulate Claude Code session persistence: without --no-session-persistence the CLI
# writes the whole session (prompt context included) under ~/.claude/projects/<encoded cwd>/.
if [[ "$persist" == "true" ]]; then
  enc="$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"
  mkdir -p "$HOME/.claude/projects/$enc"
  jq -nc --arg cwd "$PWD" --arg t "persisted headless session: ${STUB_MARKER:-SELF-INGEST-MARKER} $(printf 'x%.0s' $(seq 1 400))" \
    '{type:"user", cwd:$cwd, message:{role:"user", content:$t}}' >> "$HOME/.claude/projects/$enc/stub-session.jsonl"
fi

result() {  # result <cost> <is_error> <subtype> <structured-json|null> [result-text]
  jq -nc --argjson cost "$1" --argjson err "$2" --arg sub "$3" --argjson so "$4" --arg res "${5:-done}" --arg mu "$model_used" '
    {type:"result", subtype:$sub, is_error:$err, duration_ms:1234, num_turns:2, result:$res,
     structured_output:$so, total_cost_usd:$cost,
     usage:{input_tokens:1200, cache_creation_input_tokens:300, cache_read_input_tokens:5000, output_tokens:800},
     modelUsage:{($mu):{costUSD:$cost}}}'
}

# STUB_OVERLOAD="<stage>:<n>[:<model>]" -> the first n calls of that stage (optionally only on
# that model) fail like a real 529 overload; STUB_FAIL_STATE is the counter dir.
# STUB_MODEL_USED overrides the modelUsage key (emulates the CLI's in-call --fallback-model).
if [[ -n "${STUB_OVERLOAD:-}" ]]; then
  IFS=: read -r ov_stage ov_n ov_model <<< "$STUB_OVERLOAD"
  if [[ "$ov_stage" == "$stage" && ( -z "$ov_model" || "$ov_model" == "$model" ) ]]; then
    cnt_f="${STUB_FAIL_STATE:-/tmp}/overload-$stage"; c=$(( $(cat "$cnt_f" 2>/dev/null || echo 0) + 1 )); echo "$c" > "$cnt_f"
    if [[ "$c" -le "$ov_n" ]]; then
      jq -nc '{type:"result", subtype:"success", is_error:true, duration_ms:900, num_turns:1, total_cost_usd:0,
               result:"API Error: 529 {\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}",
               usage:{input_tokens:0, output_tokens:0}}'
      exit 1
    fi
  fi
fi
[[ -n "${STUB_MODEL_USED:-}" ]] && model_used="$STUB_MODEL_USED" || model_used="$model"

case "${STUB_FAIL:-}" in
  budget)  result 1.25 true error_max_budget_usd null; exit 1 ;;
  budget0) result 0.31 true error_max_budget_usd null; exit 0 ;;   # error result with exit 0
  crash)   echo "stub crash" >&2; exit 2 ;;
  hangup)  printf '{"type":"result","subt'; echo "Error: socket hang up" >&2; exit 1 ;;   # died mid-stream
esac

if [[ "$stage" == "triage" ]]; then
  digest="${STUB_DIGEST:-Settled the Turbo-Flow ingest architecture: K8s CronJob feeding a work queue.}"
  if [[ "${STUB_TRIAGE:-one}" == "garbage" ]]; then
    result 0.02 false success null "I could not decide, sorry."
    exit 0
  fi
  first="$(printf '%s' "$input" | sed -n 's/^<file path="\(bundle\/transcripts\/[^"]*\)">$/\1/p' | head -1)"
  cands='[]'
  case "${STUB_TRIAGE:-one}" in
    one)
      cands="$(jq -nc --arg f "${first:-bundle/transcripts/missing.txt}" '[{id:"c1", title:"Turbo-Flow ingest: CronJob + work queue",
        category:"infra/kubernetes", why:"architecture decision with tradeoffs",
        evidence:[{file:$f, start_line:2, end_line:3}, {file:"../../etc/passwd", start_line:1, end_line:5}]}]')" ;;
    dupid)   # a valid c1 followed by an INVALID candidate that reuses id c1 (title too short)
      cands="$(jq -nc --arg f "${first:-bundle/transcripts/missing.txt}" '[{id:"c1", title:"Turbo-Flow ingest: CronJob + work queue",
        category:"infra/kubernetes", why:"architecture decision with tradeoffs", evidence:[{file:$f, start_line:2, end_line:3}]},
        {id:"c1", title:"x", category:"ideas", why:"w", evidence:[{file:$f, start_line:1, end_line:2}]}]')" ;;
    traversal)
      cands='[{"id":"c1","title":"x","category":"ideas","why":"x","evidence":[{"file":"bundle/../../../etc/passwd","start_line":1,"end_line":9},{"file":"/etc/hosts","start_line":1,"end_line":9}]}]' ;;
  esac
  obj="$(jq -nc --arg d "$digest" --arg hl "${STUB_HIGHLIGHT:-}" --argjson c "$cands" \
    '{digest_summary:$d, highlights:((["ingest architecture decided"] + (if $hl == "" then [] else [$hl] end)) | join("\n")), candidates:$c}')"
  result "${STUB_TRIAGE_COST:-0.03}" false success "$obj"
  exit 0
fi

# writer stage: pages as structured bodies
pg() {  # pg <slug> <title> [extra-body-html] [category]
  jq -nc --arg s "$1" --arg t "$2" --arg b "${3:-}" --arg c "${4:-infra/kubernetes}" '{candidate_id: "c1", slug: $s, title: $t,
    category: $c, tags: ["k8s"], summary: "CronJob + work queue; idempotent workers.", source: "claude-code:turbo-flow",
    body_html: ("<h2>Decision</h2><p>CronJob + queue; worker must be idempotent.</p>" + $b)}'
}
p=""
add() { p="${p:+$p,}$1"; }
case "${STUB_PAGES:-one}" in
  none) ;;
  malformed)    # one good page, one with a non-string body, one reusing the good slug
       add "$(pg k8s-cronjob-queue-ingest "Title ONE" "<p>BODY ONE</p>")"
       add '{"candidate_id":"c1","slug":"object-body-page","title":"x","category":"ideas","tags":[],"summary":"x","source":"x","body_html":{"x":1}}'
       add "$(pg k8s-cronjob-queue-ingest "Title TWO" "<p>BODY TWO</p>")" ;;
  grounding)    # one page whose code comes from the transcript, one that invents its commands
       add "$(pg grounded-cronjob-page "CronJob pinned to spot with a PDB" '<pre><code>kubectl get cronjobs
activeDeadlineSeconds: 600
PodDisruptionBudget</code></pre>')"
       add "$(pg invented-helm-page "Helm rollout for the ingest workers" '<pre><code>helm upgrade ingest ./charts/ingest --set queue.maxRetries=7
kubectl rollout restart deploy/ingest-worker --grace-period=30
export INGEST_QUEUE_URL=amqp://mq.internal:5672/ingest
kubectl get cronjobs</code></pre>')" ;;
  paraphrase)   # same topic as "one" under a different slug, plus an unrelated page
       add "$(pg cronjob-work-queue-for-turbo-flow "Turbo-Flow ingest via K8s CronJob and a work queue")"
       add "$(pg spot-pool-pdb-batch "Spot node pool with a PDB for batch ingest")" ;;
  one) add "$(pg k8s-cronjob-queue-ingest "Turbo-Flow ingest: CronJob + work queue")" ;;
  two) add "$(pg k8s-cronjob-queue-ingest "Turbo-Flow ingest: CronJob + work queue")"
       add "$(pg spot-pool-pdb-batch "Spot pool + PDB for batch ingest")" ;;
  unsafe)
    add "$(pg safe-page-one "Safe page")"
    add "$(pg inline-script-page "Script page" "<script>alert(1)</script>")"
    add "$(pg onload-handler-page "Handler page" "<img src=x onerror=\"alert(1)\">")"
    add "$(pg external-img-page "External img" "<img src='//evil.example/p.png'>")"
    add "$(pg iframe-page "Iframe page" "<iframe src=\"about:blank\"></iframe>")"
    add "$(pg leaked-stripe-page "Stripe page" "<p>key sk_live_ABCDEFGHIJKLMNOPQRSTUVWX</p>")" ;;
  unsafe2)
    add "$(pg safe-page-two "Safe page two" '<p>code: <code>&lt;img onerror=x&gt;</code>, a &lt;script&gt; mention, 1 < 2 and b > a</p><table><tr><th>k</th><td>v</td></tr></table><br/>')"
    add "$(pg quoted-gt-page "Unsafe quoted-gt-page" '<img alt=">" onerror=alert(1) src=x>')"
    add "$(pg entity-js-page "Unsafe entity-js-page" '<a href="&#106;avascript:alert(1)">x</a>')"
    add "$(pg tab-js-page "Unsafe tab-js-page" '<a href="java&#9;script:alert(1)">x</a>')"
    add "$(pg css-url-page "Unsafe css-url-page" '<div style="background:url(&#47;&#47;evil/x)">x</div>')"
    add "$(pg object-page "Unsafe object-page" '<object data="x"></object>')"
    add "$(pg meta-refresh-page "Unsafe meta-refresh-page" '<meta http-equiv="refresh" content="0;url=https://evil">')"
    add "$(pg https-link-page "Unsafe https-link-page" '<a href="https://example.com">x</a>')"
    add "$(pg import-page "Unsafe import-page" '<style>@import "x.css";</style>')" ;;
  category)
    add "$(pg clean-page "Clean page")"
    add "$(pg cat-leak-page "Rollout notes" "" "clients/globex")" ;;
  client)
    add "$(pg clean-page "Clean page")"
    add "$(pg client-page "Rollout notes" "<p>Deployed for Globex Corporation last night.</p>")" ;;
esac
result 0.12 false success "{\"pages\":[${p}]}"
